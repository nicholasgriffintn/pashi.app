{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 100,
	"tabWidth": 2,
	"useTabs": true,
	"semi": true,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"trailingComma": "all",
	"bracketSpacing": true,
	"arrowParens": "always",
	"objectWrap": "preserve",
	"sortImports": {
		"newlinesBetween": true,
		"sortSideEffects": false
	},
	"sortPackageJson": {
		"sortScripts": true
	},
	"ignorePatterns": [
		"**/dist/**",
		"**/.wrangler/**",
		"**/.integration-dist/**",
		"**/worker-configuration.d.ts",
		"**/pnpm-lock.yaml",
		"**/data/web-features.ts"
	]
}
