{
	"name": "pashi",
	"private": true,
	"description": "Pashi is a fast generator toolkit named for the pashi impact SFX",
	"type": "module",
	"scripts": {
		"build": "tsc -b && vite build",
		"check": "tsc -b",
		"deploy": "pnpm check && pnpm build && wrangler deploy",
		"dev": "node scripts/seed-dev-key.mjs && vite",
		"fix": "oxlint --fix && oxfmt",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"preview": "pnpm build && vite preview",
		"seed:dev": "node scripts/seed-dev-key.mjs",
		"test": "echo \"Error: DO NOT ADD UNIT TESTS, THIS PROJECT IS SUPPOSED TO BE FUN! (E2E / INTEGRATION MAY BE ACCEPTABLE, NOT UNIT, EVER)\" && exit 1",
		"test:smoke": "playwright test",
		"test:smoke:install": "playwright install chromium",
		"types": "wrangler types"
	},
	"dependencies": {
		"@cloudflare/containers": "^0.3.7",
		"@tanstack/react-query": "^5.102.8",
		"hono": "4.13.5",
		"isbot": "^5.2.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-router-dom": "^7.18.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.54.3",
		"@playwright/test": "^1.62.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "26.4.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@vitejs/plugin-react": "6.1.1",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "7.0.2",
		"vite": "^8.2.2",
		"wrangler": "4.128.0"
	},
	"packageManager": "pnpm@11.24.0"
}
